# Copy to .env locally — NEVER commit .env to git.
# The frontend demo runs 100% key-free on OpenFreeMap + verified local JSON artifacts.

# Optional: toggle strict public-only valuation benchmarks (true | false)
VITE_USE_PUBLIC_BENCHMARKS_ONLY=false

# Optional: offline enrichment / research scripts only (not needed to run the demo UI)
COMPANIES_HOUSE_API_KEY=
NOMIS_API_KEY=

# Live Grok co-pilot (host laptop only; used by the Vite dev-server proxy at /api/grok, never sent to the browser)
XAI_API_KEY=
XAI_MODEL=grok-4
